# Токен Яндекс.Диска: https://yandex.ru/dev/disk/poligon/
YA_DISK_TOKEN=AQAAA_paste_your_token_here

# Куда складывать файлы. DOWNLOAD_DIR оставлен для совместимости со старыми
# версиями; новым установкам достаточно DISK_DIR и UNLIM_DIR.
DISK_DIR=D:/YandexDiskBackup/Disk
DOWNLOAD_DIR=D:/YandexDiskBackup/Disk
UNLIM_DIR=D:/YandexDiskBackup/Unlim

# Сколько потоков скачивания (0 или пусто — подобрать автоматически)
MAX_WORKERS=4
LOG_LEVEL=INFO

# Превью отложенных фото: уменьшенная копия в папке «_превью», пока оригинал
# ждёт ответа серверов Яндекса. 1 — включены (по умолчанию), 0 — выключены.
PREVIEWS=1

# Что копировать из облака (можно менять в окне: «Настройки» → «Что копировать»).
# Папки обычного Диска, которые обходить. Через запятую, / — весь Диск.
DISK_SCAN_ROOTS=/
# Тип контента Безлимита: photos, videos или all.
UNLIM_MEDIA=all

# Необязательно: куда писать базы, логи, куки и настройки.
# По умолчанию в установленной версии: %LOCALAPPDATA%\YandexDiskBackup
# YADISK_DATA_DIR=C:/Users/User/AppData/Local/YandexDiskBackup

# Необязательно: адрес и порт локального сервера оконной версии.
# По умолчанию 127.0.0.1:8000; при занятом порте выбирается следующий.
# WEBUI_HOST=127.0.0.1
# WEBUI_PORT=8000

# Необязательно: отправка диагностических отчётов.
# Ключ можно не хранить здесь, а ввести на вкладке «Диагностика».
# REPORT_KEY=
# REPORT_URL=https://yadisk-backup-reports.ex3544.workers.dev
